# ==============================================================================
# RL-ORCHESTRATED MULTI-AGENT DEEPFAKE DETECTION AND FORENSIC VERIFICATION SYSTEM
# Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="ForensicGuard AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration
DATABASE_URL="sqlite:///./forensic_cases.db"

# Storage Settings
STORAGE_DIR="./storage"
ORIGINAL_UPLOADS_DIR="./storage/originals"
PROCESSED_MEDIA_DIR="./storage/processed"
ARTIFACTS_DIR="./storage/artifacts"
REPORTS_DIR="./reports"

# Model Execution Profiles: FAST | BALANCED | DEEP_FORENSIC
EXECUTION_PROFILE="BALANCED"
DEVICE="cpu"

# Model Checkpoint Paths
EFFICIENTNET_WEIGHTS="./weights/spatial_efficientnet_b0.pt"
SWIN_WEIGHTS="./weights/temporal_swin_tiny.pt"
WAV2VEC2_WEIGHTS="./weights/audio_wav2vec2_base.pt"
DEBERTA_WEIGHTS="./weights/context_deberta_v3.pt"
PPO_POLICY_WEIGHTS="./weights/ppo_orchestrator_policy.pt"

# External Fact-Checking & Intelligence APIs (Optional - Graceful Fallback if blank)
GDELT_API_KEY=""
GOOGLE_FACT_CHECK_API_KEY=""
NEWS_API_KEY=""
EVENT_REGISTRY_API_KEY=""
SOURCE_SEARCH_API_KEY=""
REVERSE_IMAGE_API_KEY=""

# Security & Upload Limits
MAX_UPLOAD_SIZE_MB=150
ALLOWED_EXTENSIONS=["mp4", "mov", "avi", "mkv", "wav", "mp3", "flac", "m4a", "jpg", "jpeg", "png", "webp"]

# Evidence Fusion & Verdict Thresholds
THRESHOLD_LIKELY_FAKE=0.65
THRESHOLD_LIKELY_REAL=0.35
UNCERTAINTY_HIGH_THRESHOLD=0.40
UNCERTAINTY_MEDIUM_THRESHOLD=0.20
